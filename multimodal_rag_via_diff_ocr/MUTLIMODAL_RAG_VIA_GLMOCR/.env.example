# ─── PARSER ───────────────────────────────────────────────────────────────────
# "cloud"  → Z.AI MaaS API (requires Z_AI_API_KEY, paid $0.03/1M tokens)
# "ollama" → fully local via Ollama + glm-ocr model (free, no key needed)
PARSER_BACKEND=ollama

# Required only when PARSER_BACKEND=cloud
Z_AI_API_KEY=

LOG_LEVEL=INFO
OUTPUT_DIR=./output

# ─── LLM / CAPTIONING ─────────────────────────────────────────────────────────
# Choose ONE of: Groq (free) OR OpenAI (paid).
# Groq takes priority when GROQ_API_KEY is set.

# -- Option A: Groq (FREE) -----------------------------------------------
# Sign up at https://console.groq.com — no credit card required.
# Vision model  : qwen/qwen3.6-27b          (image captioning)
# Text model    : meta/llama-3.3-70b-versatile  (table/formula/algorithm)
GROQ_API_KEY=""
GROQ_VISION_MODEL="qwen/qwen3.6-27b"
GROQ_TEXT_MODEL="llama-3.3-70b-versatile"
GROQ_BASE_URL=https://api.groq.com/openai/v1

# -- Option B: OpenAI (PAID) ---------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_LLM_MODEL=gpt-4o

# ─── EMBEDDINGS ───────────────────────────────────────────────────────────────
# EMBEDDING_PROVIDER options:
#   "local"  → sentence-transformers on CPU (FREE, no key)   ← recommended
#   "openai" → OpenAI text-embedding-* (PAID, needs OPENAI_API_KEY)
#   "gemini" → Google Gemini embeddings (needs GEMINI_API_KEY)

# -- Option A: Local sentence-transformers (FREE) ────────────────────────
# First run downloads model weights from HuggingFace (~22 MB for MiniLM).
# Other good models: BAAI/bge-small-en-v1.5 (384d), all-mpnet-base-v2 (768d)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# -- Option B: OpenAI embeddings (PAID) ──────────────────────────────────
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIMENSIONS=3072

# -- Option C: Gemini embeddings ─────────────────────────────────────────
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=gemini-embedding-2-preview
# GEMINI_API_KEY=AIzaSy...
# EMBEDDING_DIMENSIONS=3072

# ⚠ Changing EMBEDDING_DIMENSIONS after collection creation requires --overwrite

# ─── QDRANT ───────────────────────────────────────────────────────────────────
# Option A: Local binary (default) — start with:
#   nohup /home/user/qdrant/qdrant > /tmp/qdrant.log 2>&1 &
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION_NAME=documents

# Option B: Qdrant Cloud (use this after ingesting via Google Colab)
# Sign up FREE at https://cloud.qdrant.io (no credit card)
# 1. Create a cluster → copy the URL and API key shown on the dashboard
# 2. Comment out Option A above and uncomment Option B below:
QDRANT_API_KEY = ''
QDRANT_URL = ''
QDRANT_COLLECTION_NAME=documents
EMBEDDING_DIMENSIONS = 384
# ⚠ Also set EMBEDDING_DIMENSIONS=384 to match what Colab ingested

# ─── RERANKER ─────────────────────────────────────────────────────────────────
# "bge"    → BAAI/bge-reranker local (FREE, fast, text-only)  ← recommended
# "qwen"   → Qwen3-VL-Reranker local (FREE, multimodal, ~8GB RAM)
# "jina"   → Jina Reranker M0 cloud  (needs JINA_API_KEY, ~$0.01/query)
# "openai" → GPT-4o-mini cross-encoder (needs OPENAI_API_KEY, ~$0.05/query)
RERANKER_BACKEND=bge
RERANKER_TOP_N=5
JINA_API_KEY=                       # only needed if RERANKER_BACKEND=jina

# ─── FEATURE FLAGS ────────────────────────────────────────────────────────────
# Set false to skip image/table/formula captioning (fully offline mode)
IMAGE_CAPTION_ENABLED=true

# ─── API SERVER ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# ─── LOGGING ──────────────────────────────────────────────────────────────────
LOG_JSON=false                      # true = JSON lines for log aggregators
