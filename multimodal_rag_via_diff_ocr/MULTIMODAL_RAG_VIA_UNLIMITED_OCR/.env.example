# Qdrant Vector DB Configuration
QDRANT_COLLECTION_NAME=multimodal_rag_v3_docs
QDRANT_API_KEY=""
QDRANT_URL=""

# Parser Backend: "docling" / "cloud" / "ollama" / "baidu"
PARSER_BACKEND=baidu

# Embedding Configuration (Local sentence-transformers, no OpenAI required)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Groq API for LLM Generation
GROQ_API_KEY=""
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# Reranker Backend: "openai" / "jina" / "bge"
RERANKER_BACKEND=bge
